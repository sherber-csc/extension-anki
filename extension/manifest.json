{
  "manifest_version": 3,
  "name": "Sherber Queue Capture",
  "version": "0.1.0",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1:8766/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "capture-selection": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "Capture the selected word into the pending queue"
    }
  },
  "action": {
    "default_title": "Capture selected word",
    "default_popup": "popup.html"
  }
}
